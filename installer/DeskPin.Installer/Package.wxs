<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="DeskPin"
           Manufacturer="DeskPin"
           Version="1.1.0"
           Language="2052"
           UpgradeCode="8E4278A5-5014-49CF-9E85-2C3A38B01D77"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="DeskPin 窗口置顶助手（未签名）" />
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 DeskPin。" />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir"
              InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />

    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="RememberDeskPinInstallFolder"
                      Root="HKCU"
                      Key="Software\DeskPin"
                      Name="InstallLocation"
                      Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DeskPin">
          <Component Id="DeskPinApplication" Guid="A287FAF7-6B09-4A6E-B93C-153280C0F6A3">
            <File Id="DeskPinExecutable"
                  Source="$(var.DeskPinPublishDir)DeskPin.exe" />
            <RegistryValue Root="HKCU"
                           Key="Software\DeskPin"
                           Name="Installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
            <RegistryValue Root="HKCU"
                           Key="Software\DeskPin"
                           Name="InstallLocation"
                           Type="string"
                           Value="[INSTALLFOLDER]" />
            <RemoveFolder Id="RemoveDeskPinInstallFolder"
                          Directory="INSTALLFOLDER"
                          On="uninstall" />
            <RemoveFolder Id="RemoveLocalProgramsFolderIfEmpty"
                          Directory="LocalProgramsFolder"
                          On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DeskPinProgramMenuFolder" Name="DeskPin">
        <Component Id="DeskPinStartMenuShortcut" Guid="*">
          <Shortcut Id="DeskPinStartMenuShortcutEntry"
                    Name="DeskPin"
                    Description="窗口置顶助手"
                    Target="[INSTALLFOLDER]DeskPin.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveDeskPinProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\DeskPin"
                         Name="StartMenuShortcutInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="DeskPinFeature" Title="DeskPin" Level="1">
      <ComponentRef Id="DeskPinApplication" />
      <ComponentRef Id="DeskPinStartMenuShortcut" />
    </Feature>

    <CustomAction Id="CleanupDeskPinStartup"
                  FileRef="DeskPinExecutable"
                  ExeCommand="--uninstall-cleanup"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CleanupDeskPinStartup"
              Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
