<Window x:Class="DeskPin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeskPin 设置"
        Width="590"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource ContentBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="0"
                            CornerRadius="11"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border x:Name="Track"
                                    Grid.Column="1"
                                    Width="46"
                                    Height="26"
                                    Margin="18,0,0,0"
                                    Background="{DynamicResource BorderBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    ClipToBounds="True"
                                    CornerRadius="13">
                                <Grid>
                                    <Ellipse x:Name="Knob"
                                             Width="20"
                                             Height="20"
                                             Margin="1,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Fill="White">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="20" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ContentBackgroundBrush}"
            BorderThickness="0"
            CornerRadius="11"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   Text="DeskPin 设置" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource ChromeButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="关闭"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseWindow_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="27" FontWeight="Bold" Text="系统设置" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,0,0,14" Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="HotkeyHeader" Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" Text="全局快捷键" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Text="按下包含 Ctrl、Alt、Shift 或 Win 的组合键" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HotkeyBox"
                                     Grid.Column="0"
                                     Margin="0,0,10,0"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     AutomationProperties.Name="全局快捷键" />
                            <Button Grid.Column="1" Content="清除" Click="ClearHotkey_Click" />
                            <TextBlock x:Name="HotkeyHint"
                                       Grid.ColumnSpan="2"
                                       Margin="2,47,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="11"
                                       Text="默认未设置快捷键" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                    <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource ToggleSwitchStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Text="开机自启动" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Grid.Row="3"
                           Margin="2,13,2,0"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" />

                <Grid Grid.Row="4">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="SaveButton"
                                MinWidth="92"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="保存设置"
                                Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
