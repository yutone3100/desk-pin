<Window x:Class="DeskPin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeskPin"
        Width="1180"
        Height="760"
        MinWidth="1080"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource ContentBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            CornerRadius="11"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ContextMenuTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource ContextMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource ContextMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="MenuItemBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="12,2"
                                Background="{DynamicResource ContextMenuSeparatorBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="WindowContextMenu"
                     x:Shared="False"
                     Width="150"
                     Padding="4"
                     Background="{DynamicResource ContextMenuBackgroundBrush}"
                     Foreground="{DynamicResource ContextMenuTextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     HasDropShadow="False"
                     OverridesDefaultStyle="True">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.DataContext>
                <Binding Path="PlacementTarget.DataContext" RelativeSource="{RelativeSource Self}" />
            </ContextMenu.DataContext>
            <MenuItem Header="打开"
                      Style="{StaticResource WindowContextMenuItemStyle}"
                      Click="ShowWindowMenuItem_Click" />
            <Separator Style="{StaticResource WindowContextMenuSeparatorStyle}" />
            <MenuItem Header="删除"
                      Style="{StaticResource WindowContextMenuItemStyle}"
                      Click="CloseWindowMenuItem_Click" />
        </ContextMenu>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="12,3" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SidebarButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SidebarButtonBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardWindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="252" />
            <Setter Property="Height" Value="218" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource CardShadowEffect}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="{DynamicResource ContentBackgroundBrush}"
            BorderThickness="0"
            CornerRadius="11"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <Border Width="27" Height="27" Background="{DynamicResource AccentBrush}" CornerRadius="7">
                            <Path Width="13"
                                  Height="16"
                                  Fill="White"
                                  Stretch="Uniform"
                                  Data="M8,0 C11.9,0 15,3.1 15,7 C15,9.7 13.5,12 11.3,13.2 L11.3,18 L8,15.2 L4.7,18 L4.7,13.2 C2.5,12 1,9.7 1,7 C1,3.1 4.1,0 8,0 Z M8,4.1 A2.9,2.9 0 1 0 8,9.9 A2.9,2.9 0 1 0 8,4.1 Z" />
                        </Border>
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SidebarTextBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Text="DeskPin" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Margin="28,0,150,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="置顶管理" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ChromeButtonStyle}"
                                    Content="&#xE921;"
                                    ToolTip="最小化"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Minimize_Click" />
                            <Button x:Name="MaximizeButton"
                                    Style="{StaticResource ChromeButtonStyle}"
                                    Content="&#xE922;"
                                    ToolTip="最大化"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Maximize_Click" />
                            <Button Style="{StaticResource ChromeButtonStyle}"
                                    Content="&#xE8BB;"
                                    ToolTip="关闭到托盘"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="Close_Click">
                                <Button.Resources>
                                    <Style TargetType="Border" />
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,30,0,0">
                            <TextBlock Margin="28,0,0,10"
                                       Foreground="{DynamicResource SidebarMutedBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="窗口" />
                            <RadioButton GroupName="WindowFilter"
                                         Style="{StaticResource SidebarNavStyle}"
                                         IsChecked="{Binding OnlyTopmost, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"
                                         Click="ShowAll_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Data="M2,2 H14 V14 H2 Z M2,6 H14" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="全部窗口" />
                                </Grid>
                            </RadioButton>
                            <RadioButton GroupName="WindowFilter"
                                         Style="{StaticResource SidebarNavStyle}"
                                         IsChecked="{Binding OnlyTopmost, Mode=OneWay}"
                                         Click="ShowPinned_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Data="M8,0 C11.9,0 15,3.1 15,7 C15,9.7 13.5,12 11.3,13.2 L11.3,18 L8,15.2 L4.7,18 L4.7,13.2 C2.5,12 1,9.7 1,7 C1,3.1 4.1,0 8,0 Z" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="已置顶" />
                                    <Border Grid.Column="2" MinWidth="24" Padding="6,2" Background="#273967" CornerRadius="9">
                                        <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" Text="{Binding PinnedWindowCount}" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,18">
                            <Border Height="1" Margin="24,0,24,12" Background="#324064" />
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="Settings_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M8,1 L9.5,2.2 L11.4,1.9 L12.3,3.6 L14.1,4.4 L13.8,6.3 L15,8 L13.8,9.7 L14.1,11.6 L12.3,12.4 L11.4,14.1 L9.5,13.8 L8,15 L6.5,13.8 L4.6,14.1 L3.7,12.4 L1.9,11.6 L2.2,9.7 L1,8 L2.2,6.3 L1.9,4.4 L3.7,3.6 L4.6,1.9 L6.5,2.2 Z M8,5 A3,3 0 1 0 8,11 A3,3 0 1 0 8,5 Z" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="设置" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="32,24,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,16"
                            Padding="12"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid HorizontalAlignment="Stretch">
                                <Path Width="16" Height="16" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5" Data="M7,1 A6,6 0 1 0 7,13 A6,6 0 1 0 7,1 Z M11.5,11.5 L16,16" />
                                <TextBox x:Name="SearchBox"
                                         Padding="10,8,12,8"
                                         AutomationProperties.Name="搜索窗口"
                                         TextAlignment="Left"
                                         ToolTip="搜索应用或窗口标题"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="24,0,0,0"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextAlignment="Left"
                                           Text="搜索应用或窗口标题">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Margin="0,0,7,0" Padding="10,6" Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource AccentBrush}" />
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                            <Run Text="窗口 " /><Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding VisibleWindowCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Padding="10,6" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="16">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource SuccessBrush}" />
                                        <TextBlock Foreground="{DynamicResource SuccessBrush}" FontSize="11">
                                            <Run Text="置顶 " /><Run FontWeight="SemiBold" Text="{Binding PinnedWindowCount, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" Margin="12,0" Padding="3" Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <Button ToolTip="卡片视图" AutomationProperties.Name="卡片视图" Click="CardsView_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z" />
                                    </Button>
                                    <Button ToolTip="列表视图" AutomationProperties.Name="列表视图" Click="ListView_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsListView}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Width="17" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Data="M1,2 H3 M5,2 H17 M1,7.5 H3 M5,7.5 H17 M1,13 H3 M5,13 H17" />
                                    </Button>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1">
                        <Border Margin="0,0,0,14"
                                Padding="12,9"
                                Background="{DynamicResource DangerSoftBrush}"
                                CornerRadius="7"
                                Visibility="{Binding HasViewPreferenceError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding ViewPreferenceError}" TextWrapping="Wrap" />
                        </Border>
                        <Border Margin="0,0,0,14"
                                Padding="12,9"
                                Background="{DynamicResource DangerSoftBrush}"
                                CornerRadius="7"
                                Visibility="{Binding HasRefreshError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding RefreshError}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding WindowsView}" Margin="-8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CardWindowButtonStyle}"
                                                Tag="{Binding}"
                                                ContextMenu="{StaticResource WindowContextMenu}"
                                                ToolTip="{Binding Title}"
                                                AutomationProperties.Name="{Binding AccessibilityLabel}"
                                                IsEnabled="{Binding DataContext.IsOperating, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                Click="ToggleWindow_Click">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Border Width="62" Height="62" HorizontalAlignment="Center" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15">
                                                        <Image Width="38"
                                                               Height="38"
                                                               SnapsToDevicePixels="True"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Source="{Binding Icon}" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="9,4" CornerRadius="10">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding StatusLabel}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,14,0,0"
                                                           HorizontalAlignment="Stretch"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Text="{Binding ProcessName}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,7,0,0"
                                                           HorizontalAlignment="Stretch"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           LineHeight="18"
                                                           MaxHeight="38"
                                                           Text="{Binding Title}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" />
                                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListView x:Name="WindowList"
                                      ItemsSource="{Binding WindowsView}"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.Resources>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Height" Value="58" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="10,4" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="ContextMenu" Value="{StaticResource WindowContextMenu}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="RowBorder"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False" ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                        <GridViewColumn Header="应用" Width="170">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="34" Height="34" Margin="0,0,10,0" Background="{DynamicResource ContentBackgroundBrush}" CornerRadius="8">
                                                            <Image Width="24"
                                                                   Height="24"
                                                                   SnapsToDevicePixels="True"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Source="{Binding Icon}" />
                                                        </Border>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="窗口标题" Width="414" DisplayMemberBinding="{Binding Title}" />
                                        <GridViewColumn Header="状态" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border HorizontalAlignment="Left" Padding="9,4" CornerRadius="10">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding StatusLabel}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="操作" Width="104">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Padding="11,5"
                                                            MinHeight="30"
                                                            Content="{Binding ActionLabel}"
                                                            Tag="{Binding}"
                                                            IsEnabled="{Binding DataContext.IsOperating, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                                            Click="ToggleWindow_Click" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <Grid Panel.ZIndex="5" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVisibleWindows}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="64" Height="64" Background="{DynamicResource AccentSoftBrush}" CornerRadius="18">
                                        <Path Width="27" Height="27" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Data="M3,4 H21 V18 H3 Z M3,8 H21 M8,21 H16 M12,18 V21" />
                                    </Border>
                                    <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" Text="没有匹配的窗口" />
                                    <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="尝试清除搜索条件，或切换到“全部窗口”" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
